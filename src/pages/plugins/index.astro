---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PluginCard from '../../components/PluginCard.astro';
import CutPaper from '../../components/CutPaper.astro';

const plugins = (await getCollection('plugins')).sort((a, b) => a.data.order - b.data.order);
const real = plugins.filter((p) => !p.data.placeholder).length;
---

<Base
  title="Tools — YNS NUR"
  description="After Effects extensions built by Younes Nur, a motion designer who ships the tools he animates with."
  field="ochre"
>
  <section class="act tools" data-field="ochre">
    <div class="wrap">
      <header class="tools__head">
        <p class="micro"><span class="tc">01:26</span> Tools</p>
        <h1 class="display off-baseline tools__title">
          <span>Built</span>
          <span>the tools</span>
        </h1>
        <p class="lead tools__lead">
          Extensions that run inside After Effects — the same software the work
          on this site was made in. A portfolio can claim taste. It cannot
          claim it built the tooling.
        </p>
        <div class="tools__wheel" aria-hidden="true"><CutPaper shape="wheel" /></div>
      </header>

      <p class="micro tools__count">
        {plugins.length} tools &middot; {real} released or in progress &middot; {plugins.length - real} placeholder entries
      </p>

      <div class="tools__grid">
        {
          plugins.map((item, i) => (
            <div data-cut={i % 2}>
              <PluginCard
                slug={item.id}
                title={item.data.title}
                tagline={item.data.tagline}
                state={item.data.state}
                price={item.data.price}
                host={item.data.host}
                placeholder={item.data.placeholder}
                poster={item.data.media.poster}
                src={item.data.media.src}
                index={i + 1}
              />
            </div>
          ))
        }
      </div>

      <aside class="tools__note">
        <p class="micro">A note on these</p>
        <p>
          Orbit is real and working; its release date and price are not decided
          yet. The other three are placeholder entries — they exist so this page
          can be judged with more than one tool on it, and so all three
          distribution states render. Replace or delete them.
        </p>
      </aside>
    </div>
  </section>
</Base>

<style>
  .tools__head {
    position: relative;
    padding-bottom: var(--stack-m);
    border-bottom: var(--rule-heavy) solid currentColor;
    margin-bottom: var(--stack-m);
  }

  .tools__title {
    display: grid;
    margin: var(--stack-s) 0 var(--stack-m);
  }

  .tools__lead {
    max-width: 42ch;
  }

  .tools__wheel {
    position: absolute;
    right: -2%;
    top: 8%;
    width: min(30%, 17rem);
    color: var(--silhouette);
    opacity: 0.9;
    display: none;
  }

  @media (width >= 62rem) {
    .tools__wheel {
      display: block;
    }
  }

  .tools__count {
    margin-bottom: var(--stack-l);
  }

  .tools__grid {
    display: grid;
    gap: var(--stack-m);
    grid-template-columns: 1fr;
  }

  @media (width >= 55rem) {
    .tools__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .tools__note {
    margin-top: var(--stack-xl);
    padding: var(--stack-m);
    max-width: 52ch;
    box-shadow: inset 0 0 0 var(--rule) var(--on-field);
  }

  .tools__note p + p {
    margin-top: 0.6rem;
  }
</style>
