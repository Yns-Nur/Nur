---
import PlaceholderMark from './PlaceholderMark.astro';
import { withBase } from '../lib/base';

/**
 * Animation that shipped inside a website. The artefact is the live site; what
 * this can honestly show is a capture, so the capture arrives with its context
 * — which part of the site it is, and how it was handed to the developers.
 */
interface Props {
  title: string;
  part: string;
  handoff: string;
  duration: string;
  index: number;
  placeholder?: boolean;
  src?: string;
  poster: string;
  width: number;
  height: number;
  url?: string;
  href?: string;
}

const { title, part, handoff, duration, index, placeholder = true, src, poster, width, height, url, href } = Astro.props;
const num = String(index).padStart(2, '0');
---

<figure class="cap" data-loop>
  <div class="cap__device">
    <div class="cap__chrome" aria-hidden="true">
      <span></span><span></span><span></span>
      <p class="cap__url micro">{url ?? 'URL not on hand'}</p>
    </div>
    <div class="cap__screen">
      <video
        class="cap__video"
        poster={withBase(poster)}
        preload="none"
        muted
        loop
        playsinline
        width={width}
        height={height}
        aria-label={`${title} — ${part} animation, no sound`}
      >
        {src && <source src={withBase(src)} type="video/mp4" />}
      </video>
      <button class="cap__play" type="button" data-loop-play hidden>
        <span class="cap__tri" aria-hidden="true"></span>
        <span class="vh">Play {title}</span>
      </button>
      {placeholder && <PlaceholderMark />}
    </div>
  </div>

  <figcaption class="cap__cap">
    <p class="cap__head">
      <span class="tc">{num}</span>
      <span class="cap__title">{href ? <a href={href}>{title}</a> : title}</span>
    </p>
    <dl class="cap__spec micro">
      <div><dt>Part</dt><dd>{part}</dd></div>
      <div><dt>Handoff</dt><dd>{handoff}</dd></div>
      <div><dt>Length</dt><dd>{duration}</dd></div>
    </dl>
  </figcaption>
</figure>

<style>
  .cap {
    margin: 0;
    display: grid;
    gap: var(--stack-s);
  }

  /* The browser as a cut-paper object, not a glossy device mockup. */
  .cap__device {
    background: var(--silhouette);
    padding: 0.55rem;
    box-shadow: 10px 10px 0 color-mix(in srgb, var(--ink) 45%, transparent);
  }

  .cap__chrome {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0 0.25rem 0.5rem;
  }

  .cap__chrome span {
    width: 0.55rem;
    height: 0.55rem;
    background: var(--field);
    flex: none;
  }

  .cap__url {
    margin-left: 0.5rem;
    color: var(--field);
    opacity: 0.75;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-transform: none;
  }

  .cap__screen {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--ink);
    overflow: hidden;
  }

  .cap__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cap__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--ink) 40%, transparent);
    border: none;
    cursor: pointer;
  }

  .cap__play[hidden] {
    display: none;
  }

  .cap__tri {
    width: 0;
    height: 0;
    border-left: 1.5rem solid var(--bone);
    border-top: 0.95rem solid transparent;
    border-bottom: 0.95rem solid transparent;
  }

  .cap__head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding-bottom: var(--stack-xs);
    border-bottom: var(--rule) solid currentColor;
  }

  .cap__head .tc {
    font-size: var(--step-micro);
  }

  .cap__title {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    text-transform: uppercase;
    line-height: 1;
  }

  .cap__title a:hover,
  .cap__title a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .cap__spec {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
    margin: var(--stack-xs) 0 0;
  }

  .cap__spec div {
    display: flex;
    gap: 0.4rem;
  }

  .cap__spec dt::after {
    content: ':';
  }

  .cap__spec dd {
    margin: 0;
    color: var(--on-field);
  }
</style>
