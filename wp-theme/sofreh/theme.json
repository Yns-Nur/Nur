{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1280px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{
					"slug": "ground",
					"name": "Ground",
					"color": "#F3F4F6"
				},
				{
					"slug": "surface",
					"name": "Surface",
					"color": "#FFFFFF"
				},
				{
					"slug": "line",
					"name": "Line",
					"color": "#E6E8EB"
				},
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#1F2328"
				},
				{
					"slug": "muted",
					"name": "Muted",
					"color": "#62666D"
				},
				{
					"slug": "accent",
					"name": "Accent",
					"color": "#D1352F"
				},
				{
					"slug": "accent-deep",
					"name": "Accent deep",
					"color": "#B32A25"
				},
				{
					"slug": "accent-soft",
					"name": "Accent soft",
					"color": "#FDECEA"
				},
				{
					"slug": "teal",
					"name": "Teal",
					"color": "#1F6F6A"
				},
				{
					"slug": "success",
					"name": "Success",
					"color": "#1A7F45"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"lineHeight": true,
			"fontFamilies": [
				{
					"slug": "vazirmatn",
					"name": "Vazirmatn",
					"fontFamily": "\"Vazirmatn FD\", Tahoma, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Vazirmatn FD",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/Vazirmatn-FD-Regular.woff2"
							]
						},
						{
							"fontFamily": "Vazirmatn FD",
							"fontWeight": "500",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/Vazirmatn-FD-Medium.woff2"
							]
						},
						{
							"fontFamily": "Vazirmatn FD",
							"fontWeight": "700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/Vazirmatn-FD-Bold.woff2"
							]
						},
						{
							"fontFamily": "Vazirmatn",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/Vazirmatn-Regular.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1rem",
					"fluid": false
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.25rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.25rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Extra large",
					"size": "1.75rem",
					"fluid": {
						"min": "1.375rem",
						"max": "1.75rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Huge",
					"size": "2.5rem",
					"fluid": {
						"min": "1.75rem",
						"max": "2.5rem"
					}
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--ground)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--vazirmatn)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.8"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent-deep)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--ink)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.45"
				},
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--surface)"
				},
				"border": {
					"radius": "8px",
					"width": "0"
				},
				"typography": {
					"fontWeight": "700",
					"fontSize": "0.9375rem",
					"lineHeight": "1.5"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-deep)",
						"text": "var(--wp--preset--color--surface)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--accent-deep)",
						"text": "var(--wp--preset--color--surface)"
					}
				}
			}
		}
	}
}
