{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1280px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{ "slug": "ivory", "name": "Ivory", "color": "#FBF8F3" },
				{ "slug": "surface", "name": "Surface", "color": "#FFFFFF" },
				{ "slug": "sand", "name": "Sand", "color": "#F3ECE1" },
				{ "slug": "line", "name": "Line", "color": "#E5DCCF" },
				{ "slug": "ink", "name": "Ink", "color": "#24211D" },
				{ "slug": "muted", "name": "Muted", "color": "#62594F" },
				{ "slug": "firuzeh", "name": "Firuzeh", "color": "#1F5A50" },
				{ "slug": "firuzeh-deep", "name": "Firuzeh deep", "color": "#163F38" },
				{ "slug": "copper", "name": "Copper", "color": "#9A5226" },
				{ "slug": "anar", "name": "Anar", "color": "#A3322A" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"lineHeight": true,
			"fontFamilies": [
				{
					"slug": "vazirmatn",
					"name": "Vazirmatn",
					"fontFamily": "\"Vazirmatn FD\", Tahoma, \"Segoe UI\", sans-serif",
					"fontFace": [
						{ "fontFamily": "Vazirmatn FD", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/Vazirmatn-FD-Regular.woff2" ] },
						{ "fontFamily": "Vazirmatn FD", "fontWeight": "500", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/Vazirmatn-FD-Medium.woff2" ] },
						{ "fontFamily": "Vazirmatn FD", "fontWeight": "700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/Vazirmatn-FD-Bold.woff2" ] },
						{ "fontFamily": "Vazirmatn", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/Vazirmatn-Regular.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.25rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "1.75rem", "fluid": { "min": "1.375rem", "max": "1.75rem" } },
				{ "slug": "xx-large", "name": "Huge", "size": "2.5rem", "fluid": { "min": "1.75rem", "max": "2.5rem" } }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--ivory)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--vazirmatn)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.85"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--firuzeh)" },
				":hover": { "color": { "text": "var(--wp--preset--color--firuzeh-deep)" } }
			},
			"heading": {
				"typography": { "fontWeight": "700", "lineHeight": "1.45" },
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--firuzeh)",
					"text": "var(--wp--preset--color--surface)"
				},
				"border": { "radius": "10px", "width": "0" },
				"typography": { "fontWeight": "500", "fontSize": "1rem", "lineHeight": "1.5" },
				"spacing": { "padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1.5rem", "right": "1.5rem" } },
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--firuzeh-deep)",
						"text": "var(--wp--preset--color--surface)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--firuzeh-deep)",
						"text": "var(--wp--preset--color--surface)"
					}
				}
			}
		}
	}
}
